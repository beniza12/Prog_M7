
#include <stdio.h>

int main() {

    float bmi;
    printf("Enter BMI: ");
    scanf("%f",&bmi);

    if (bmi>=30.0){
        printf("Category: Obese");
    } 
    else if(bmi>=25){
        printf("Category: Overweight");
    }
    else if(bmi>=18.5){
        printf("Category: Normal");
    } else{
        printf("Category: Underweight");
    }
    
    

    return 0;
}
