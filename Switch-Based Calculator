
#include <stdio.h>

int main() {

    float num1, num2;
     float result;
    char operator;


    printf("Enter first number: ");
        scanf("%f", &num1);

    printf("Enter operator(+,-,*,/): ");
    scanf(" %c", &operator);
    
    printf("Enter second number: ");
        scanf("%f",& num2);

   
    

    switch(operator){
        case '+':
        result = num1 + num2;
        break;

        case '-':
        result = num1 - num2;
        break;

        case '*':
        result = num1 * num2;
        break;

        case '/':
        result = num1 / num2;
        break;

        default:
        printf("Invalid");
        break;
    }

    printf("Result: %.2f %c %.2f = %.2f",num1,operator, num2 ,result);
    
    
    

    return 0;
}
